# =========================================================
# Eco-Loop Building Agents - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# Never commit your actual .env file to version control.
# =========================================================

# API key for the LLM provider (OpenAI-compatible).
OPENAI_API_KEY=your_openai_api_key_here

# Model used by the LLM agent for decision making.
OPENAI_MODEL=gpt-4o-mini

# Host and port for the FastAPI server.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Interval (in seconds) between controller decision cycles.
CONTROLLER_INTERVAL_SECONDS=5

# Comfort thresholds used by the fallback rule-based decision engine.
COMFORT_TEMP_MIN=20.0
COMFORT_TEMP_MAX=26.0
